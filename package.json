{
  "name": "catsuggest",
  "version": "2.0.0",
  "description": "",
  "main": "catsuggest.js",
  "scripts": {
    "build": "node build.js --dev",
    "build:prod": "node build.js",
    "dev": "concurrently -n build,serve \"npm run build -- --watch\" \"npm run serve:watch\"",
    "serve": "node bin/server.js",
    "serve:watch": "nodemon --watch dist --watch catsuggest.css --ext js,css bin/server.js",
    "deploy": "npm run test && npm run build:prod && node bin/deploy.js",
    "cattree": "node bin/cattree.js",
    "lint": "eslint \"src/*.{js,vue,css}\"",
    "format": "prettier --write \"src/**/*.{js,vue,css,json}\" \"bin/*.js\" \"catsuggest.css\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"bin/*.js\" \"catsuggest.css\"",
    "test:unit": "vitest run",
    "test": "npm run lint && npm run format:check && npm run test:unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@wikimedia/codex-icons": "^2.6.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-wikimedia": "^0.32.4",
    "mwn": "^3.0.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "vite": "^8.0.16",
    "vitest": "^3.0.2"
  }
}